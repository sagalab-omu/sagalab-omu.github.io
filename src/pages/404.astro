---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { localizePath } from '~/i18n/ui';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">お探しのページが見つかりませんでした。</p>
        <p class="mt-2 text-xl font-semibold" lang="en">Sorry, we couldn't find this page.</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          ホームページから他のコンテンツをご覧いただけます。<br />
          <span lang="en">But don't worry, you can find plenty of other things on our homepage.</span>
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">ホームへ戻る</a>
        <a rel="noopener noreferrer" href={localizePath(getHomePermalink(), 'en')} class="btn ml-4" lang="en">Back to homepage</a>
      </div>
    </div>
  </section>
</Layout>
